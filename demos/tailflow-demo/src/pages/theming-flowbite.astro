---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Theming — Tailwind Config">
	<main class="max-w-4xl mx-auto px-6 py-10">

		<span class="bg-blue-100 text-blue-800 text-sm font-medium me-2 px-3 py-1 rounded-full">Tailwind Theming</span>

		<section class="py-12">
			<h1 class="text-4xl font-extrabold tracking-tight mb-4">Theming with Tailwind</h1>
			<p class="text-lg text-gray-500 mb-10 max-w-2xl">
				Tailwind lets you define a design system through its theme configuration. Colors, spacing, fonts, and more are defined once and used everywhere via utility classes.
			</p>

			<!-- HOW IT WORKS -->
			<div class="mb-12">
				<h2 class="text-2xl font-bold mb-4">How it works</h2>
				<div class="bg-gray-900 text-gray-100 rounded-lg p-6 font-mono text-sm leading-relaxed overflow-x-auto">
					<p class="text-gray-400 mb-2">/* global.css — Tailwind v4 theme config */</p>
					<p><span class="text-purple-400">@theme</span> {'{'}</p>
					<p class="pl-4"><span class="text-green-400">--color-brand</span>: <span class="text-yellow-300">#2563eb</span>;</p>
					<p class="pl-4"><span class="text-green-400">--color-brand-light</span>: <span class="text-yellow-300">#dbeafe</span>;</p>
					<p class="pl-4"><span class="text-green-400">--color-accent</span>: <span class="text-yellow-300">#f59e0b</span>;</p>
					<p class="pl-4"><span class="text-green-400">--font-display</span>: <span class="text-yellow-300">"Inter", sans-serif</span>;</p>
					<p class="pl-4"><span class="text-green-400">--spacing-card</span>: <span class="text-yellow-300">2rem</span>;</p>
					<p>{'}'}</p>
				</div>
				<p class="mt-4 text-sm text-gray-500">Then use them as utilities: <code class="bg-gray-100 px-1.5 py-0.5 rounded text-gray-800">bg-brand</code>, <code class="bg-gray-100 px-1.5 py-0.5 rounded text-gray-800">text-accent</code>, <code class="bg-gray-100 px-1.5 py-0.5 rounded text-gray-800">font-display</code>, <code class="bg-gray-100 px-1.5 py-0.5 rounded text-gray-800">p-card</code></p>
			</div>

			<!-- LIVE DEMO -->
			<div class="mb-12">
				<h2 class="text-2xl font-bold mb-4">Live demo</h2>
				<p class="text-gray-500 mb-6">These cards use the custom theme tokens defined above.</p>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<div class="p-6 bg-brand-light rounded-lg border border-brand/20">
						<h3 class="font-bold text-brand text-lg mb-2">Brand Color</h3>
						<p class="text-sm text-gray-600">This card uses <code class="bg-white/60 px-1 rounded">bg-brand-light</code> and <code class="bg-white/60 px-1 rounded">text-brand</code>.</p>
					</div>
					<div class="p-6 bg-accent/10 rounded-lg border border-accent/20">
						<h3 class="font-bold text-accent text-lg mb-2">Accent Color</h3>
						<p class="text-sm text-gray-600">This card uses <code class="bg-white/60 px-1 rounded">bg-accent/10</code> and <code class="bg-white/60 px-1 rounded">text-accent</code>.</p>
					</div>
					<div class="p-card bg-gray-50 rounded-lg border border-gray-200">
						<h3 class="font-bold text-gray-900 text-lg mb-2">Custom Spacing</h3>
						<p class="text-sm text-gray-600">This card uses <code class="bg-white/60 px-1 rounded">p-card</code> for the custom spacing token.</p>
					</div>
				</div>
			</div>

			<!-- BENEFITS -->
			<div class="mb-12">
				<h2 class="text-2xl font-bold mb-4">Benefits</h2>
				<ul class="space-y-3">
					<li class="flex items-start gap-3">
						<span class="mt-1 w-5 h-5 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-xs font-bold shrink-0">1</span>
						<span class="text-gray-700"><strong>Single source of truth</strong> — change a token once, it updates everywhere.</span>
					</li>
					<li class="flex items-start gap-3">
						<span class="mt-1 w-5 h-5 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-xs font-bold shrink-0">2</span>
						<span class="text-gray-700"><strong>Auto-generated utilities</strong> — define <code class="bg-gray-100 px-1 rounded">--color-brand</code> and you get <code class="bg-gray-100 px-1 rounded">bg-brand</code>, <code class="bg-gray-100 px-1 rounded">text-brand</code>, <code class="bg-gray-100 px-1 rounded">border-brand</code>, etc.</span>
					</li>
					<li class="flex items-start gap-3">
						<span class="mt-1 w-5 h-5 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-xs font-bold shrink-0">3</span>
						<span class="text-gray-700"><strong>Opacity modifiers</strong> — use <code class="bg-gray-100 px-1 rounded">bg-brand/50</code> for 50% opacity without extra tokens.</span>
					</li>
					<li class="flex items-start gap-3">
						<span class="mt-1 w-5 h-5 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-xs font-bold shrink-0">4</span>
						<span class="text-gray-700"><strong>IDE support</strong> — autocomplete suggests your custom tokens alongside built-in ones.</span>
					</li>
				</ul>
			</div>

			<!-- LINK -->
			<div class="pt-8 border-t border-gray-200">
				<p class="text-sm text-gray-500">
					<a href="/theming-vanilla" class="text-green-600 hover:underline font-medium">See the same approach with CSS custom properties &rarr;</a>
				</p>
			</div>
		</section>
	</main>
</Layout>
