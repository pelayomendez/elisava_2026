---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Centered Element — Flowbite + Tailwind">
	<div class="min-h-screen flex items-center justify-center bg-gray-50">
		<div class="text-center p-10 bg-white rounded-2xl shadow-lg border border-gray-200 max-w-md w-full mx-4">
			<div class="w-16 h-16 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-6 text-2xl font-bold">
				&#10038;
			</div>
			<h1 class="text-2xl font-bold text-gray-900 mb-2">Centered with Tailwind</h1>
			<p class="text-gray-500 mb-6">This card is perfectly centered using Flexbox utilities — no custom CSS needed.</p>
			<div class="flex gap-3 justify-center">
				<span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full">flex</span>
				<span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full">items-center</span>
				<span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full">justify-center</span>
			</div>
			<a href="/centered-vanilla" class="inline-block mt-8 text-sm text-green-600 hover:underline font-medium">
				See the plain CSS version &rarr;
			</a>
		</div>
	</div>
</Layout>
