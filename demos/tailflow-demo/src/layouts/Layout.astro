---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="bg-white text-gray-900 min-h-screen">
		<nav class="bg-gray-100 border-b border-gray-200 px-6 py-4">
			<div class="max-w-6xl mx-auto flex items-center justify-between">
				<span class="text-xl font-bold">TailFlow Demo</span>
				<div class="flex gap-4 flex-wrap">
					<a href="/" class="text-gray-600 hover:text-gray-900">Home</a>
					<a href="/flowbite" class="text-blue-600 hover:text-blue-800 font-medium">Full Page — Tailwind</a>
					<a href="/vanilla" class="text-green-600 hover:text-green-800 font-medium">Full Page — CSS</a>
					<a href="/centered-flowbite" class="text-blue-600 hover:text-blue-800 font-medium">Centered — Tailwind</a>
					<a href="/centered-vanilla" class="text-green-600 hover:text-green-800 font-medium">Centered — CSS</a>
					<a href="/theming-flowbite" class="text-blue-600 hover:text-blue-800 font-medium">Theming — Tailwind</a>
					<a href="/theming-vanilla" class="text-green-600 hover:text-green-800 font-medium">Theming — CSS</a>
					<a href="/comparison" class="text-purple-600 hover:text-purple-800 font-medium">Comparison</a>
				</div>
			</div>
		</nav>
		<slot />
		<script is:inline src="https://cdn.jsdelivr.net/npm/flowbite@3/dist/flowbite.min.js"></script>
	</body>
</html>
