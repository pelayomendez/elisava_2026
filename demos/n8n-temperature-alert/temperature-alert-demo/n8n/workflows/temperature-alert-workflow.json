{
  "name": "Temperature Alert Demo",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "temperature-alert",
        "responseMode": "responseNode",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
                "name": "Access-Control-Allow-Headers",
                "value": "Content-Type"
              }
            ]
          }
        }
      },
      "id": "8e0670ac-e3df-4df4-a055-14f3c0b7ab89",
      "name": "Temperature Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -420,
        0
      ],
      "webhookId": "temperature-alert-demo"
    },
    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\nconst deviceId = String(input.deviceId || 'unknown-device').trim() || 'unknown-device';\nconst temperature = Number(input.temperature);\n\nlet severity = 'normal';\nlet message = 'Temperature is normal. No action needed.';\n\nif (!Number.isFinite(temperature)) {\n  severity = 'error';\n  message = 'Temperature must be a number.';\n} else if (temperature >= 50) {\n  severity = 'critical';\n  message = 'Temperature is dangerously high. Stop the device and inspect it now.';\n} else if (temperature >= 35) {\n  severity = 'warning';\n  message = 'Temperature is above normal. Check the device.';\n}\n\nreturn [\n  {\n    json: {\n      deviceId,\n      temperature,\n      severity,\n      message,\n      shouldSendEmail: severity === 'warning' || severity === 'critical',\n      email: {\n        From: {\n          Email: 'alerts@temperature-demo.local',\n          Name: 'Temperature Alert Demo',\n        },\n        To: [\n          {\n            Email: 'teacher@example.test',\n            Name: 'Classroom Demo',\n          },\n        ],\n        Subject: `[${severity.toUpperCase()}] ${deviceId} is ${temperature}C`,\n        Text: `${message}\\n\\nDevice: ${deviceId}\\nTemperature: ${temperature}C\\nSeverity: ${severity}`,\n        Tags: ['temperature-alert-demo', severity],\n      },\n    },\n  },\n];"
      },
      "id": "d6707305-f74d-4bf3-9f08-8d1705cb0338",
      "name": "Evaluate Temperature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "3b9b010e-11a8-42b8-a260-5e7b280f2d20",
              "leftValue": "={{ $json.shouldSendEmail }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f69054cb-00ef-4e93-b58c-a9e3bb0a5b67",
      "name": "High Reading?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        100,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://mailpit:8025/api/v1/send",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json.email }}",
        "options": {}
      },
      "id": "64e678de-108d-4222-af54-d7a273b4cf1f",
      "name": "Send Local Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        360,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "const alert = $('Evaluate Temperature').first().json;\n\nreturn [\n  {\n    json: {\n      deviceId: alert.deviceId,\n      temperature: alert.temperature,\n      severity: alert.severity,\n      message: alert.message,\n    },\n  },\n];"
      },
      "id": "025296cf-c3eb-4cd8-9efa-0403fe46b1ed",
      "name": "Prepare Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
                "name": "Access-Control-Allow-Headers",
                "value": "Content-Type"
              }
            ]
          }
        }
      },
      "id": "1f0f910b-d01e-4ae8-a203-07cdba128285",
      "name": "Return JSON",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        880,
        0
      ]
    }
  ],
