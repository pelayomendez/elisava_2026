<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.betterme.agent</string>

    <key>ProgramArguments</key>
    <array>
      <string>/ABSOLUTE/PATH/TO/python3</string>
      <string>/ABSOLUTE/PATH/TO/agent-interaction/stage-4-background-agent/better-me-agent/backend/background_agent.py</string>
      <string>--once</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/agent-interaction/stage-4-background-agent/better-me-agent/backend</string>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/tmp/better-me-agent.out.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/better-me-agent.err.log</string>
  </dict>
</plist>
