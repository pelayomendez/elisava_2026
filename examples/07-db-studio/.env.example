# Which database backend to use: mock | prisma | mongoose | supabase
DB_BACKEND=mock

# PostgreSQL (Milestone 2 — Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/games_voting?schema=public"

# MongoDB (Milestone 3 — Mongoose)
MONGODB_URI="mongodb://localhost:27017/games_voting"

# Supabase (Milestone 4)
# Server-side (service role key for full access)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key"

# Client-side (public, for realtime subscriptions)
PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
