<span class="realtime-badge">LIVE</span>

<style>
  .realtime-badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    color: white;
    background: #22c55e;
    animation: pulse 2s infinite;
    margin-left: 0.5rem;
    vertical-align: middle;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
</style>
