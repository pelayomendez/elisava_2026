---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/games", label: "Games" },
  { href: "/studio", label: "Studio" },
  { href: "/about", label: "About" },
];

const currentPath = Astro.url.pathname;
---

<header>
  <nav>
    <a class="logo" href="/">
      <span class="logo-icon">&#9649;</span>
      <span class="logo-text">Autonomous Game Studio</span>
    </a>
    <ul>
      {navLinks.map(({ href, label }) => (
        <li>
          <a href={href} class={currentPath === href ? "active" : ""}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #0a0a0f;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
  }

  nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: #fff;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .logo-icon {
    font-size: 1.4rem;
    color: #7c6ff7;
  }

  .logo-text {
    background: linear-gradient(90deg, #7c6ff7, #c084fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.25rem;
  }

  ul a {
    display: block;
    padding: 0.4rem 0.9rem;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.15s, background 0.15s;
  }

  ul a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.07);
  }

  ul a.active {
    color: #c084fc;
    background: rgba(124, 111, 247, 0.12);
  }
</style>
